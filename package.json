{
  "name": "wawisync",
  "version": "1.0.3",
  "description": "Electron App zur Synchronisation von Warenbeständen zwischen POS-System und Shopify",
  "main": "electron/dist/electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:build:ts": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json && tsc-esm-fix --target electron/dist && node -e \"const fs = require('fs'); const path = require('path'); const src = path.join('electron', 'dist', 'electron', 'electron', 'preload.js'); const dest = path.join('electron', 'dist', 'electron', 'preload.cjs'); if (fs.existsSync(src)) { fs.copyFileSync(src, dest); console.log('Preload.js zu preload.cjs kopiert'); }\"",
    "fix:html": "node scripts/fix-html-base-tag.js",
    "electron:dev": "npm run electron:build:ts && concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && npm run fix:html && npm run electron:build:ts && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "electron:build:mac": "npm run build && npm run fix:html && npm run electron:build:ts && electron-builder --mac",
    "electron:build:linux": "npm run build && npm run fix:html && npm run electron:build:ts && electron-builder --linux",
    "electron:build:all": "npm run build && npm run fix:html && npm run electron:build:ts && electron-builder --win --mac --linux",
    "electron:build:mac:publish": "npm run build && npm run fix:html && npm run electron:build:ts && electron-builder --mac --publish always",
    "electron:build:win:publish": "npm run build && npm run fix:html && npm run electron:build:ts && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish always",
    "electron:build:linux:publish": "npm run build && npm run fix:html && npm run electron:build:ts && electron-builder --linux --publish always",
    "electron:build:all:publish": "node scripts/build-all-platforms-publish.js",
    "electron:build:prod": "node scripts/build-with-signing.js",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "changelog:update": "node scripts/update-changelog.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest tests/unit",
    "test:integration": "vitest tests/integration",
    "test:parity": "vitest tests/parity",
    "test:a11y": "vitest --config vitest.config.a11y.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:performance": "vitest --config vitest.config.performance.ts",
    "test:performance:benchmarks": "vitest --config vitest.config.performance.ts tests/performance/benchmarks.test.ts",
    "test:performance:memory": "vitest --config vitest.config.performance.ts tests/performance/memory-leak.test.ts",
    "test:performance:load": "vitest --config vitest.config.performance.ts tests/performance/load.test.ts",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "test:mutation:ci": "stryker run --reporters html clear-text",
    "test:all": "vitest run && playwright test",
    "test:workflows": "bash scripts/test-workflows.sh",
    "size-limit": "size-limit",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "keywords": [
    "electron",
    "nextjs",
    "shopify",
    "inventory",
    "sync"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bebin29/shpysync.git"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "axios": "^1.7.2",
    "better-sqlite3": "^11.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^5.5.6",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.1.7",
    "iconv-lite": "^0.7.0",
    "lucide-react": "^0.427.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "winston": "^3.14.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@size-limit/preset-app": "^12.0.0",
    "@stryker-mutator/core": "^8.0.0",
    "@stryker-mutator/typescript-checker": "^8.0.0",
    "@stryker-mutator/vitest-runner": "^8.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^20.19.27",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.4.23",
    "@playwright/test": "^1.48.0",
    "jest-axe": "^8.0.0",
    "jsdom": "^24.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.38",
    "prettier": "^3.7.4",
    "semantic-release": "^23.0.2",
    "size-limit": "^12.0.0",
    "tailwindcss": "^3.4.19",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  }
}
